{
    "name": "survos/deployment-bundle",
    "description": "Tools for deploying Survos projects to dokku",
    "keywords": [
        "symfony-ux",
        "symfony",
        "dev"
    ],
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": "^8.5",
        "symfony/config": "^7.4||^8.1",
        "symfony/dependency-injection": "^7.4||^8.1",
        "symfony/http-kernel": "^7.4||^8.1",
        "twig/twig": "^3.4|^4.0",
        "symfony/form": "^7.4||^8.1",
        "symfony/console": "^7.4||^8.1",
        "symfony/process": "^7.4||^8.1",
        "survos/kit-bundle": "^2.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "symfony/browser-kit": "^7.4||^8.1",
        "symfony/framework-bundle": "^7.4||^8.1",
        "symfony/phpunit-bridge": "^7.4||^8.1",
        "symfony/twig-bundle": "^7.4||^8.1",
        "symfony/var-dumper": "^7.4||^8.1"
    },
    "autoload": {
        "psr-4": {
            "Survos\\DeploymentBundle\\": "src/"
        }
    }
}
